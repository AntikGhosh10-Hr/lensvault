# ==============================================================================
# LensVault Environment Variables Configuration Template
# Keep secrets strictly on the server - Never expose service role to browser code
# ==============================================================================

# Next.js Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-lensvault-domain.com

# Cryptographic Session Secret (Min 32 characters)
SESSION_SECRET=lensvault_production_ultra_secure_secret_key_change_in_production_32_chars!

# Supabase Database & Private Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Photographer / Studio Administrator Credentials
PHOTOGRAPHER_EMAIL=boss@lensvault.com
PHOTOGRAPHER_PASSWORD=LensVault2026!

# Neural Face-Recognition Python Microservice URL
FACE_SERVICE_URL=http://localhost:8000
FACE_MATCH_THRESHOLD=0.65
